{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/css/(.*)",
      "dest": "/frontend/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/frontend/js/$1"
    },
    {
      "src": "/(index\\.html)?$",
      "dest": "/frontend/index.html"
    },
    {
      "src": "/404(\\.html)?",
      "dest": "/frontend/404.html",
      "status": 404
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/404.html",
      "status": 404
    }
  ]
}
